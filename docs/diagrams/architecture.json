      "dot": "cyan",
      "title": "Block devices",
      "items": [
        "Seven FSKit extensions, one per filesystem",
        "Each links one Rust staticlib from crates.io",
        "qcow2, VHD, VHDX and VMDK open inside every extension"
      ]
