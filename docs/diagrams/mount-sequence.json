  "cards": [
    {
      "dot": "cyan",
      "title": "Nothing needs root",
      "items": [
        "hdiutil runs in the unsandboxed agent",
        "DiskArbitration mounts each slice at its own label"
      ]
    },
    {
      "dot": "emerald",
      "title": "The extension is chosen by probing",
      "items": [
        "fskitd asks each FSKit module whether it recognises the slice",
        "Each extension's Rust driver reads the superblock"
      ]
    },
    {
      "dot": "violet",
      "title": "Replay waits for a writable device",
      "items": [
        "The volume is loaded with journal replay deferred",
